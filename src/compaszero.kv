#:import C cz.theme.C
#:import MONO cz.theme.MONO
#:import icon cz.theme.icon

<Label>:
    color: C.chalk

<Surface@BoxLayout>:
    canvas.before:
        Color:
            rgba: C.graphite
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: C.line
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)
            width: dp(1)

<Card>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(76)
    padding: dp(18), dp(12), dp(16), dp(12)
    canvas.before:
        Color:
            rgba: C.graphite if self.state == "normal" else C.graphite2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: C.line
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
            width: dp(1)
        Color:
            rgba: C.rec
        RoundedRectangle:
            pos: self.x, self.y + dp(16)
            size: dp(3), self.height - dp(32)
            radius: [dp(2)]
    Label:
        text: root.title
        font_size: "17sp"
        bold: True
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        text: root.subtitle
        font_size: "13sp"
        color: C.muted
        text_size: self.size
        halign: "left"
        valign: "middle"

<BarRow>:
    size_hint_y: None
    height: max(dp(48), lyric.texture_size[1] + dp(24))
    padding: dp(12), dp(8)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: C.graphite
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    Label:
        id: lyric
        text: root.text
        markup: True
        font_name: MONO
        font_size: "15sp"
        text_size: self.width, None
        halign: "left"
        valign: "middle"
    Label:
        text: str(root.syllables)
        font_name: MONO
        font_size: "12sp"
        color: C.muted
        size_hint: None, None
        size: dp(34), dp(22)
        pos_hint: {"center_y": .5}
        canvas.before:
            Color:
                rgba: C.graphite2
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(11)]

<FlatButton@ButtonBehavior+Label>:
    color: C.chalk
    font_size: "15sp"

<RecButton@ButtonBehavior+Label>:
    color: C.chalk
    bold: True
    canvas.before:
        Color:
            rgba: C.rec if self.state == "normal" else C.rec_off
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<Chip@ToggleButtonBehavior+Label>:
    size_hint: None, None
    size: self.texture_size[0] + dp(28), dp(34)
    font_size: "13sp"
    bold: self.state == "down"
    allow_no_selection: False
    canvas.before:
        Color:
            rgba: C.rec if self.state == "down" else C.graphite
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(17)]
        Color:
            rgba: (0, 0, 0, 0) if self.state == "down" else C.line
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(17)
            width: dp(1)

<LyricInput@TextInput>:
    # teclado nativo de Android con autocorrector y sugerencias
    input_type: "text"
    keyboard_suggestions: True
    font_name: MONO
    font_size: "16sp"
    background_normal: ""
    background_active: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: C.field
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: C.rec if self.focus else C.line
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
            width: dp(1.2)
        Color:  # Kivy pinta el texto con el último color activo
            rgba: self.foreground_color if self.text else self.hint_text_color
    foreground_color: C.chalk
    cursor_color: C.rec
    hint_text_color: C.muted
    padding: dp(12), dp(12)

<Composer>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(8)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: C.graphite
        Rectangle:
            pos: self.pos
            size: self.size
    StackLayout:
        id: kinds
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(6)
    BoxLayout:
        id: rhyme_box
        orientation: "vertical"
        size_hint_y: None
        height: 0
        opacity: 0
        Label:
            id: rhyme_title
            font_size: "12sp"
            color: C.muted
            size_hint_y: None
            height: dp(18)
            text_size: self.size
            halign: "left"
        ScrollView:
            do_scroll_y: False
            bar_width: 0
            BoxLayout:
                id: rhymes
                size_hint_x: None
                width: self.minimum_width
                spacing: dp(6)
    BoxLayout:
        size_hint_y: None
        height: dp(52)
        spacing: dp(8)
        LyricInput:
            id: field
            hint_text: root.hint
            multiline: False
            write_tab: False
            text_validate_unfocus: False
            on_text: root.on_field(self.text)
            on_text_validate: root.submit()
        IconButton:
            source: icon("voz" if root.listening else "voz_off")
            size_hint_x: None
            width: dp(40)
            on_release: root.dictate()
        RoundIcon:
            source: icon("enviar")
            size_hint: None, None
            size: dp(50), dp(50)
            pos_hint: {"center_y": .5}
            on_release: root.submit()
    Label:
        text: root.count
        font_size: "12sp"
        color: C.muted
        size_hint_y: None
        height: dp(16)
        text_size: self.size
        halign: "left"

<RhymeWord@ButtonBehavior+Label>:
    size_hint_x: None
    width: self.texture_size[0] + dp(20)
    font_name: MONO
    font_size: "14sp"
    canvas.before:
        Color:
            rgba: C.graphite2 if self.state == "normal" else C.rec
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

<TopBar@BoxLayout>:
    size_hint_y: None
    height: dp(56)
    padding: dp(8), 0
    canvas.before:
        Color:
            rgba: C.ink
        Rectangle:
            pos: self.pos
            size: self.size

<RecDot>:
    size_hint: None, None
    size: dp(96), dp(96)
    canvas:
        Color:
            rgba: C.chalk
        Line:
            ellipse: self.x + dp(3), self.y + dp(3), self.width - dp(6), self.height - dp(6)
            width: dp(3)
        Color:
            rgba: self.dot
        Ellipse:
            pos: self.center_x - dp(22), self.center_y - dp(22)
            size: dp(44), dp(44)


<IconButton@ButtonBehavior+Image>:
    fit_mode: "contain"
    size_hint: None, None
    size: dp(44), dp(44)
    opacity: .6 if self.state == "down" else 1

<RoundIcon@ButtonBehavior+Image>:
    fit_mode: "contain"
    canvas.before:
        Color:
            rgba: C.rec if self.state == "normal" else C.rec_off
        Ellipse:
            pos: self.pos
            size: self.size

<NavItem>:
    orientation: "vertical"
    padding: 0, dp(8), 0, dp(6)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: (C.rec[0], C.rec[1], C.rec[2], .16) if self.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.center_x - dp(30), self.top - dp(40)
            size: dp(60), dp(32)
            radius: [dp(16)]
    Image:
        source: icon(root.icon_name if root.active else root.icon_name + "_off")
        fit_mode: "contain"
        size_hint_y: None
        height: dp(28)
    Label:
        text: root.name
        font_size: "12sp"
        bold: root.active
        color: C.chalk if root.active else C.muted
        size_hint_y: None
        height: dp(16)

<TextInputCutCopyPaste>:
    size: "300sp", "48sp"
